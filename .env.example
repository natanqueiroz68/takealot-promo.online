# ─────────────────────────────────────────────────────────────────────────────
# Takealot Promo — Environment Variables
# Copy this file to .env.local for local development.
# Set these in Vercel Dashboard → Project Settings → Environment Variables.
# NEVER commit .env or .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Upstash Redis (https://upstash.com → Create Database → REST API) ─────────
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE_ID.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# ── Webhook Secret (from paw-house.shop / zenofyetsembasms.online panel) ─────
# Set the same value in both paw-house.shop webhook settings AND here.
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_FROM_PAW_HOUSE

# ── Status Update Secret (you create this — used for POST /api/status) ───────
# Choose a strong random secret (e.g. openssl rand -hex 32)
STATUS_UPDATE_SECRET=YOUR_STRONG_RANDOM_SECRET

# ── Product Images (publicly accessible URLs of product photos) ───────────────
# Default fallback if product-specific image is missing
PRODUCT_IMAGE_DEFAULT=https://www.takealot-promo.online/assets/cookware-default.jpg

# Per-product image (env key = PRODUCT_IMAGE_ + productId with non-alphanum replaced by _)
# Product: dm-c53zv3u7et → env key: PRODUCT_IMAGE_DM_C53ZV3U7ET
PRODUCT_IMAGE_DM_C53ZV3U7ET=https://www.takealot-promo.online/assets/cookware-set.jpg
